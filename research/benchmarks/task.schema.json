{
  "$defs": {
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "graph_function",
            "point",
            "line_slope",
            "text",
            "moving_point",
            "manual"
          ],
          "title": "Kind",
          "type": "string"
        },
        "expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expression"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "slope": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slope"
        },
        "tolerance": {
          "default": 0.03,
          "exclusiveMinimum": 0,
          "maximum": 0.2,
          "title": "Tolerance",
          "type": "number"
        },
        "essential": {
          "default": true,
          "title": "Essential",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "description",
        "kind"
      ],
      "title": "Requirement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z0-9_-]+$",
      "title": "Id",
      "type": "string"
    },
    "family_id": {
      "title": "Family Id",
      "type": "string"
    },
    "category": {
      "enum": [
        "algebra",
        "functions",
        "calculus",
        "geometry",
        "linear_algebra",
        "probability_statistics"
      ],
      "title": "Category",
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "split": {
      "enum": [
        "dev",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "prompt": {
      "title": "Prompt",
      "type": "string"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    },
    "provenance": {
      "title": "Provenance",
      "type": "string"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "audited"
      ],
      "title": "Status",
      "type": "string"
    },
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "family_id",
    "category",
    "difficulty",
    "split",
    "prompt",
    "requirements",
    "provenance"
  ],
  "title": "Task",
  "type": "object"
}